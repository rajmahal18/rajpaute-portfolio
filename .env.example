# Optional: change the unlinked owner benchmark route at build time.
# This is obscurity only; credentials remain the real protection.
VITE_OWNER_MATH_ROUTE=/lab/mm-rp-314159

# OpenDota-backed Dota 2 activity calendar (Steam32 friend/account ID preferred)
# A SteamID64 also works; the server converts it to Steam32.
DOTA_ACCOUNT_ID=
DOTA_TIME_ZONE=Asia/Manila
# Optional: higher OpenDota request limits. Keep server-side only.
OPENDOTA_API_KEY=
